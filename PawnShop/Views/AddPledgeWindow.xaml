<Window x:Class="PawnShop.Views.AddPledgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PawnShop.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Добавление залога" 
        Height="800" 
        Width="500"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <materialDesign:Card Margin="16" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Новый залог"
                          Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                          Margin="0,0,0,24"
                          HorizontalAlignment="Center"/>

                <materialDesign:Card Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Client ID -->
                        <ComboBox
                           x:Name="ClientComboBox"
                           Style="{StaticResource MaterialDesignOutlinedComboBox}"
                           materialDesign:HintAssist.Hint="Клиент"
                           DisplayMemberPath="FullName"
                           SelectedValuePath="ClientID"
                           Margin="0,8,0,16"/>
                        
                        <!-- Item Description -->
                        <TextBox
                            x:Name="ItemDescriptionTextBox"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            materialDesign:HintAssist.Hint="Описание товара"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            MinHeight="80"
                            Margin="0,8,0,16"/>

                        <!-- Estimated Value -->
                        <TextBox
                            x:Name="EstimatedValueTextBox"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            materialDesign:HintAssist.Hint="Оценочная стоимость"
                            materialDesign:TextFieldAssist.PrefixText="₽"
                            Margin="0,8,0,16"/>

                        <!-- Loan Amount -->
                        <TextBox
                            x:Name="LoanAmountTextBox"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            materialDesign:HintAssist.Hint="Сумма кредита"
                            materialDesign:TextFieldAssist.PrefixText="₽"
                            Margin="0,8,0,16"/>

                        <!-- Interest Rate -->
                        <TextBox
                            x:Name="InterestRateTextBox"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            materialDesign:HintAssist.Hint="Процентная ставка"
                            materialDesign:TextFieldAssist.SuffixText="%"
                            Margin="0,8,0,16"/>

                        <!-- Pledge Date -->
                        <DatePicker
                            x:Name="PledgeDatePicker"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            materialDesign:HintAssist.Hint="Дата залога"
                            Margin="0,8,0,16"/>

                        <!-- Due Date -->
                        <DatePicker
                            x:Name="DueDatePicker"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            materialDesign:HintAssist.Hint="Срок оплаты"
                            Margin="0,8,0,16"/>

                        <!-- Status -->
                        <ComboBox
                            x:Name="StatusComboBox"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            materialDesign:HintAssist.Hint="Статус залога"
                            Margin="0,8,0,16">
                            <ComboBoxItem Content="Активный"/>
                            <ComboBoxItem Content="Погашен"/>
                            <ComboBoxItem Content="Продан"/>
                        </ComboBox>

                        <!-- Add Button -->
                        <Button
                            Content="ДОБАВИТЬ ЗАЛОГ"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="SavePledge_Click"
                            Height="40"
                            materialDesign:ButtonAssist.CornerRadius="20"
                            Margin="0,16,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>
    </materialDesign:Card>
</Window>