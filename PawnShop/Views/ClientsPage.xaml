<UserControl x:Class="PawnShop.Views.ClientsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="0" Margin="5">
            <Button Content="Добавить клиента" Click="AddClientButton_Click" Width="160" Height="30"/>
            <StackPanel Orientation="Vertical" Margin="8,0,8,0">
                <TextBlock Text="ФИО:" Margin="0,0,0,2"/>
                <TextBox x:Name="SearchFullNameTextBox" Width="200" Height="25"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,0,8,0">
                <TextBlock Text="Паспорт:" Margin="0,0,0,2"/>
                <TextBox x:Name="SearchPassportTextBox" Width="150" Height="25"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,0,8,0">
                <TextBlock Text="Телефон:" Margin="0,0,0,2"/>
                <TextBox x:Name="SearchPhoneTextBox" Width="150" Height="25"/>
            </StackPanel>
            <Button Content="Поиск" Click="SearchButton_Click" Width="100" Height="30" Margin="0,0,5,0"/>
            <Button Content="Сбросить" Click="ResetButton_Click" Width="100" Height="30"/>
        </StackPanel>

        <DataGrid Name="ClientsDataGrid" AutoGenerateColumns="False" Grid.Row="1" Margin="5"
                  ColumnWidth="*"
                  ItemsSource="{Binding FilteredClients}"  
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CanUserAddRows="False" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ClientID}" Width="50"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Пасспорт" Binding="{Binding PassportNumber}" Width="*"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding PhoneNumber}" Width="*"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Редактировать" Click="EditClientMenuItem_Click" />
                    <MenuItem Header="Удалить" Click="DeleteClientMenuItem_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</UserControl>


