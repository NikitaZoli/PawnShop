<UserControl x:Class="PawnShop.Views.EmployeesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PawnShop.Views"
      mc:Ignorable="d" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10">
            <Button x:Name="AddEmployeeButton" 
                    Content="Добавить сотрудника" 
                    Click="AddEmployeeButton_Click" 
                    Width="200" 
                    Height="30"/>
        </StackPanel>

        <DataGrid Name="EmployeesDataGrid" 
                  AutoGenerateColumns="False" 
                  Margin="10" 
                  Grid.Row="1" 
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID Сотрудника" Binding="{Binding EmployeeID}" Width="*"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="*"/>
                <DataGridTextColumn Header="Дата Найма" Binding="{Binding HireDate, StringFormat={}{0:yyyy-MM-dd}}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>