<Window x:Class="PawnShop.Views.AddTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Добавление транзакции" 
        Height="580" 
        Width="400"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <materialDesign:Card Margin="16" Padding="16">
        <StackPanel>
            <TextBlock Text="Новая транзакция"
                      Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                      Margin="0,0,0,24"
                      HorizontalAlignment="Center"/>

            <materialDesign:Card Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <ComboBox
                        x:Name="TransactionTypeComboBox"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        materialDesign:HintAssist.Hint="Тип транзакции"
                        Margin="0,8,0,16">
                        <ComboBoxItem Content="Выдача займа"/>
                        <ComboBoxItem Content="Погашение займа"/>
                        <ComboBoxItem Content="Продление займа"/>
                    </ComboBox>

                    <DatePicker
                        x:Name="TransactionDatePicker"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                        materialDesign:HintAssist.Hint="Дата транзакции"
                        Margin="0,8,0,16"/>

                    <TextBox
                        x:Name="AmountTextBox"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        materialDesign:HintAssist.Hint="Сумма"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        materialDesign:TextFieldAssist.PrefixText="₽"
                        PreviewTextInput="AmountTextBox_PreviewTextInput"
                        Margin="0,8,0,16"/>

                    <ComboBox
                        x:Name="PledgeComboBox"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        materialDesign:HintAssist.Hint="Выберите залог"
                        DisplayMemberPath="ItemDescription"
                        SelectedValuePath="PledgeID"
                        Margin="0,8,0,16"/>

                    <Button
                        Content="ДОБАВИТЬ ТРАНЗАКЦИЮ"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="AddButton_Click"
                        Height="40"
                        materialDesign:ButtonAssist.CornerRadius="20"
                        Margin="0,16,0,0"/>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </materialDesign:Card>
</Window>