<UserControl x:Class="PawnShop.Views.TransactionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PawnShop.Views"
      mc:Ignorable="d">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="0" Margin="5" >
            <Button Content="Добавить транзакцию" Click="AddTransactionButton_Click" Width="200" Height="30"/>
        </StackPanel>

        <DataGrid Name="TransactionsDataGrid" AutoGenerateColumns="False" Margin="10,3,10,0" Grid.Row="1" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="EmployeeID" Binding="{Binding EmployeeId}" Width="*"/>
                <DataGridTextColumn Header="ID Транзакции" Binding="{Binding TransactionID}" Width="*"/>
                <DataGridTextColumn Header="ID Залога" Binding="{Binding PledgeID}" Width="*"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding TransactionType}" Width="*"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding TransactionDate, StringFormat={}{0:yyyy-MM-dd}}" Width="*"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat={}{0:C}}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
