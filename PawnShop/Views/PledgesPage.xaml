<UserControl x:Class="PawnShop.Views.PledgesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Кнопки и поиск -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="5">
            <Button Content="Добавить залог" 
                    Click="SavePledge_Click" 
                    Width="200" 
                    Height="30"/>
            <TextBox x:Name="SearchTextBox"
                     Width="200"
                     Height="30"
                     Margin="10,0,0,0"
                     Text="Поиск..."
                     Foreground="Gray"
                     GotFocus="SearchTextBox_GotFocus"
                     LostFocus="SearchTextBox_LostFocus"
                     TextChanged="SearchTextBox_TextChanged"/>
        </StackPanel>

        <!-- Фильтры поиска -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="5">
            <RadioButton Content="По ID" 
                         Name="SearchByIdRadio" 
                         IsChecked="True" 
                         Margin="0,0,10,0"
                         Checked="SearchRadioButton_Checked"/>
            <RadioButton Content="По ID клиента" 
                         Name="SearchByClientIdRadio" 
                         Margin="0,0,10,0"
                         Checked="SearchRadioButton_Checked"/>
            <RadioButton Content="По описанию" 
                         Name="SearchByDescriptionRadio"
                         Margin="0,0,10,0"
                         Checked="SearchRadioButton_Checked"/>
            <RadioButton Content="По статусу"
                         Name="SearchByStatusRadio"
                         Checked="SearchRadioButton_Checked"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Name="PledgesDataGrid"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding Pledges}"
                  ColumnWidth="*"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Grid.Row="2"
                  Margin="5"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding PledgeID}" Width="50"/>
                <DataGridTextColumn Header="ID Клиента" Binding="{Binding ClientID}" Width="*"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding ItemDescription}" Width="*"/>
                <DataGridTextColumn Header="Стоимость" Binding="{Binding EstimatedValue}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Редактировать" Click="EditPledgeMenuItem_Click" />
                    <MenuItem Header="Удалить" Click="DeletePledgeMenuItem_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</UserControl>